{
  "language": "General",
  "version": "1.0.0",
  "description": "범용 코딩 표준 체크리스트",
  "categories": [
    {
      "name": "코드 가독성",
      "rules": [
        {
          "id": "line-length",
          "name": "라인 길이 제한",
          "severity": "info",
          "pattern": ".{120,}",
          "message": "라인이 너무 깁니다. 120자 이하로 유지하세요",
          "autofix": false
        },
        {
          "id": "consistent-indentation",
          "name": "일관된 들여쓰기",
          "severity": "warning",
          "pattern": "^( {1,3}|\\t {1,})\\S",
          "message": "들여쓰기가 일관되지 않습니다. 스페이스 또는 탭 중 하나만 사용하세요",
          "autofix": false
        },
        {
          "id": "trailing-whitespace",
          "name": "후행 공백 제거",
          "severity": "info",
          "pattern": "\\s+$",
          "message": "라인 끝의 불필요한 공백을 제거하세요",
          "autofix": true
        }
      ]
    },
    {
      "name": "주석 및 문서화",
      "rules": [
        {
          "id": "todo-comments",
          "name": "TODO 주석 확인",
          "severity": "info",
          "pattern": "TODO|FIXME|HACK|XXX",
          "message": "TODO/FIXME 주석이 있습니다. 이슈로 전환을 고려하세요",
          "autofix": false
        },
        {
          "id": "commented-code",
          "name": "주석 처리된 코드",
          "severity": "warning",
          "pattern": "^\\s*(?://|#)\\s*(?:if|for|while|function|def|class|const|let|var)\\s",
          "message": "주석 처리된 코드가 있습니다. 삭제를 고려하세요",
          "autofix": false
        }
      ]
    },
    {
      "name": "보안",
      "rules": [
        {
          "id": "hardcoded-secrets",
          "name": "하드코딩된 시크릿",
          "severity": "error",
          "pattern": "(?:password|secret|api_key|apikey|token|credential)\\s*[=:]\\s*['\"][^'\"]+['\"]",
          "message": "하드코딩된 시크릿이 발견되었습니다. 환경 변수를 사용하세요",
          "autofix": false
        },
        {
          "id": "hardcoded-ip",
          "name": "하드코딩된 IP 주소",
          "severity": "warning",
          "pattern": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
          "message": "하드코딩된 IP 주소가 있습니다. 설정 파일을 사용하세요",
          "autofix": false
        }
      ]
    },
    {
      "name": "로깅",
      "rules": [
        {
          "id": "debug-statements",
          "name": "디버그 문",
          "severity": "warning",
          "pattern": "\\b(console\\.log|print|System\\.out\\.println|Debug\\.Log)\\s*\\(",
          "message": "디버그 문이 있습니다. 프로덕션 배포 전 제거하세요",
          "autofix": false
        }
      ]
    },
    {
      "name": "파일 구조",
      "rules": [
        {
          "id": "file-too-long",
          "name": "파일 길이 제한",
          "severity": "info",
          "pattern": null,
          "checkType": "fileLength",
          "maxLines": 500,
          "message": "파일이 너무 깁니다. 분리를 고려하세요",
          "autofix": false
        },
        {
          "id": "function-too-long",
          "name": "함수 길이 제한",
          "severity": "info",
          "pattern": null,
          "checkType": "functionLength",
          "maxLines": 50,
          "message": "함수가 너무 깁니다. 분리를 고려하세요",
          "autofix": false
        }
      ]
    }
  ]
}
