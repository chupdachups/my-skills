{
  "template": {
    "name": "prompt_name",
    "description": "프롬프트 설명",
    "arguments": [
      {"name": "arg1", "description": "인자 설명", "required": true}
    ],
    "messages": [
      {"role": "user", "content": "{{arg1}}에 대해 분석해주세요."}
    ]
  },
  "roles": ["user", "assistant"],
  "variableSyntax": "{{variable}}",
  "examples": [
    {
      "name": "code_review",
      "description": "코드를 리뷰하고 개선점을 제안합니다",
      "arguments": [
        {"name": "code", "description": "리뷰할 코드", "required": true},
        {"name": "language", "description": "프로그래밍 언어", "required": true}
      ],
      "messages": [
        {"role": "user", "content": "다음 {{language}} 코드를 리뷰해주세요:\n\n```{{language}}\n{{code}}\n```\n\n코드 품질, 잠재적 버그, 개선 제안을 포함해주세요."}
      ]
    },
    {
      "name": "summarize_issues",
      "description": "이슈 목록을 요약합니다",
      "arguments": [
        {"name": "issues", "description": "이슈 목록 JSON", "required": true}
      ],
      "messages": [
        {"role": "user", "content": "다음 이슈들을 카테고리별로 요약해주세요:\n{{issues}}"}
      ]
    }
  ]
}
